// ════════════════════════════════════════════════════════════════════════════
//  Basera — MongoDB schema (Prisma 6.19; Prisma 7 does not support MongoDB yet)
//  Conventions
//   • Collections are snake_case plurals (@@map); fields are camelCase.
//   • IDs are UUID v7 strings stored in _id (time-ordered, same format the API validates).
//   • Money and areas are stored as Float (rupees); all arithmetic is done in integer paise
//     in code (toPaise/fromPaise in @estate/shared) — never add or subtract stored floats directly.
//   • Instants are Date; calendar dates (attendance, leave, payroll periods) are Date at UTC midnight.
//   • Relations are enforced by Prisma (no database foreign keys in MongoDB).
//   • Indexes Prisma cannot declare (2dsphere location, partial uniques on optional fields such as
//     users.email) are created by IndexesService at start-up.
//   • Business entities that must never disappear use soft delete (deletedAt).
//   • Enum values mirror constants in @estate/shared (verified by a unit test).
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

