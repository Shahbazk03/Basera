// ═════════════════════════ Identity & access ═════════════════════════

model User {
  id                 String      @id @default(uuid(7)) @map("_id")
  email              String?
  phone              String?
  passwordHash       String?
  fullName           String
  avatarUrl          String?
  accountType        AccountType @default(CUSTOMER)
  status             UserStatus  @default(ACTIVE)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  /// Set when an administrator assigns a temporary password; only auth endpoints work until the user picks their own.
  mustChangePassword Boolean     @default(false)
  isDemo             Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  sessions                Session[]
  verificationTokens      VerificationToken[]
  memberships             OrganizationMember[]
  userRoles               UserRole[]                 @relation("UserRoleUser")
  grantedRoles            UserRole[]                 @relation("UserRoleGrantedBy")
  verifiedOrganizations   Organization[]             @relation("OrgVerifiedBy")
  reviewedOrgDocuments    OrganizationDocument[]     @relation("OrgDocReviewedBy")
  uploadedFiles           StoredFile[]               @relation("FileUploadedBy")
  listedProperties        Property[]                 @relation("PropertyListedBy")
  propertyStatusChanges   PropertyStatusHistory[]    @relation("PropertyStatusChangedBy")
  favourites              PropertyFavourite[]
  propertyReports         PropertyReport[]           @relation("PropertyReportReporter")
  resolvedPropertyReports PropertyReport[]           @relation("PropertyReportResolver")
  brokerProfile           BrokerProfile?
  createdProjects         Project[]                  @relation("ProjectCreatedBy")
  projectStatusChanges    ProjectStatusHistory[]     @relation("ProjectStatusChangedBy")
  projectTeams            ProjectTeamMember[]
  unitStatusChanges       UnitStatusHistory[]        @relation("UnitStatusChangedBy")
  unitReservations        UnitReservation[]          @relation("UnitReservedBy")
  createdDomains          ProjectDomain[]            @relation("DomainCreatedBy")
  publishedPages          ProjectPage[]              @relation("PagePublishedBy")
  pageRevisions           ProjectPageRevision[]      @relation("PageRevisionBy")
  customerRecords         Customer[]                 @relation("CustomerUser")
  assignedLeads           Lead[]                     @relation("LeadAssignedTo")
  createdLeads            Lead[]                     @relation("LeadCreatedBy")
  leadAssignmentsReceived LeadAssignment[]           @relation("AssignmentAssignee")
  leadAssignmentsMade     LeadAssignment[]           @relation("AssignmentAssigner")
  managedSalesTeams       SalesTeam[]                @relation("SalesTeamManager")
  salesTeamMemberships    SalesTeamMember[]
  leadActivities          LeadActivity[]             @relation("ActivityPerformer")
  followUpsAssigned       LeadFollowUp[]             @relation("FollowUpAssignee")
  followUpsCreated        LeadFollowUp[]             @relation("FollowUpCreator")
  siteVisitsAssigned      SiteVisit[]                @relation("SiteVisitAssignee")
  siteVisitsCreated       SiteVisit[]                @relation("SiteVisitCreator")
  dealsAsSales            Deal[]                     @relation("DealSalesUser")
  dealsCreated            Deal[]                     @relation("DealCreatedBy")
  dealPaymentsRecorded    DealPayment[]              @relation("DealPaymentRecorder")
  employee                Employee?
  employeeDocsUploaded    EmployeeDocument[]         @relation("EmpDocUploader")
  attendanceReviews       AttendanceCorrection[]     @relation("AttCorrectionReviewer")
  leaveApprovals          LeaveRequest[]             @relation("LeaveApprover")
  tasksAssigned           EmployeeTask[]             @relation("TaskAssignee")
  tasksCreated            EmployeeTask[]             @relation("TaskCreator")
  salaryStructuresCreated SalaryStructure[]          @relation("SalaryStructureCreator")
  payrollRunsCreated      PayrollRun[]               @relation("PayrollCreatedBy")
  payrollRunsCalculated   PayrollRun[]               @relation("PayrollCalculatedBy")
  payrollRunsApproved     PayrollRun[]               @relation("PayrollApprovedBy")
  salaryPaymentsRecorded  SalaryPayment[]            @relation("SalaryPaymentRecorder")
  adjustmentsCreated      PayrollAdjustment[]        @relation("AdjustmentCreator")
  commissionsReceived     CommissionRecord[]         @relation("CommissionRecipientUser")
  commissionsApproved     CommissionRecord[]         @relation("CommissionApprover")
  payoutsReceived         CommissionPayout[]         @relation("PayoutRecipientUser")
  payoutsRecorded         CommissionPayout[]         @relation("PayoutRecorder")
  transactionsRecorded    FinanceTransaction[]       @relation("TxnRecorder")
  expensesCreated         Expense[]                  @relation("ExpenseCreator")
  expensesApproved        Expense[]                  @relation("ExpenseApprover")
  invoicesCreated         Invoice[]                  @relation("InvoiceCreator")
  reimbursementsApproved  Reimbursement[]            @relation("ReimbursementApprover")
  cmsPagesUpdated         CmsPage[]                  @relation("CmsPageUpdater")
  notifications           Notification[]
  communications          CommunicationLog[]         @relation("CommRecipient")
  auditLogs               AuditLog[]                 @relation("AuditActor")
  settingsUpdated         SystemSetting[]            @relation("SettingUpdater")
  subscriptionsCreated    OrganizationSubscription[] @relation("SubscriptionCreatedBy")

  @@index([accountType, status])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid(7)) @map("_id")
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Groups sessions created from the same device/login flow
  familyId          String
  /// SHA-256 of the current refresh token (rotated on every refresh)
  refreshTokenHash  String    @unique
  /// SHA-256 of the previous refresh token — presenting it after the grace window revokes the session (theft detection)
  previousTokenHash String?
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  lastUsedAt        DateTime?
  rotatedAt         DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  /// Wrong current-password attempts on change-password in this session (it is signed out after 5)
  passwordChecks    Int?      @default(0)
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([previousTokenHash])
  @@map("sessions")
}

model VerificationToken {
  id         String                @id @default(uuid(7)) @map("_id")
  userId     String?
  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationTokenType
  /// Email address or phone number the token was sent to
  target     String
  tokenHash  String
  attempts   Int                   @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([target, type])
  @@index([tokenHash])
  @@map("verification_tokens")
}

model Organization {
  id                  String             @id @default(uuid(7)) @map("_id")
  name                String
  slug                String             @unique
  type                OrganizationType
  status              OrganizationStatus @default(PENDING)
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  legalName           String?
  email               String?
  phone               String?
  whatsappNumber      String?
  website             String?
  logoUrl             String?
  description         String?
  addressLine         String?
  cityId              String?
  city                City?              @relation(fields: [cityId], references: [id])
  pincode             String?
  gstin               String?
  panNumber           String?
  reraRegistrationNo  String?
  /// Whether this organisation's projects can be published without platform review
  projectPublishMode  ProjectPublishMode @default(REQUIRES_APPROVAL)
  /// Whether customers may see the organisation's direct contact details on listings
  showContactPublicly Boolean            @default(false)
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          User?              @relation("OrgVerifiedBy", fields: [verifiedById], references: [id])
  rejectionReason     String?
  isDemo              Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  members               OrganizationMember[]
  userRoles             UserRole[]
  documents             OrganizationDocument[]
  files                 StoredFile[]
  properties            Property[]
  brokerProfiles        BrokerProfile[]
  developerProfile      DeveloperProfile?
  subscriptions         OrganizationSubscription[]
  managedProjects       Project[]                  @relation("ProjectManagingOrg")
  developedProjects     Project[]                  @relation("ProjectDeveloperOrg")
  domains               ProjectDomain[]
  customers             Customer[]
  enquiries             Enquiry[]
  leads                 Lead[]
  leadProvider          LeadProvider?
  assignmentRules       AssignmentRule[]
  salesTeams            SalesTeam[]
  campaigns             Campaign[]
  deals                 Deal[]                     @relation("DealOrg")
  brokeredDeals         Deal[]                     @relation("DealBrokerOrg")
  departments           Department[]
  designations          Designation[]
  employees             Employee[]
  shifts                Shift[]
  holidays              Holiday[]
  leaveTypes            LeaveType[]
  tasks                 EmployeeTask[]
  salaryComponents      SalaryComponent[]
  payrollRuns           PayrollRun[]
  commissionRules       CommissionRule[]           @relation("CommissionRuleOrg")
  brokerCommissionRules CommissionRule[]           @relation("CommissionRuleBrokerOrg")
  commissionRecords     CommissionRecord[]         @relation("CommissionOrg")
  commissionsReceived   CommissionRecord[]         @relation("CommissionRecipientOrg")
  payouts               CommissionPayout[]         @relation("PayoutOrg")
  payoutsReceived       CommissionPayout[]         @relation("PayoutRecipientOrg")
  transactions          FinanceTransaction[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  invoices              Invoice[]                  @relation("InvoiceIssuerOrg")
  invoicesBilled        Invoice[]                  @relation("InvoiceBillToOrg")
  reimbursements        Reimbursement[]

  @@index([type, status])
  @@index([verificationStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  isOwner        Boolean      @default(false)
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Role {
  id          String    @id @default(uuid(7)) @map("_id")
  key         String    @unique
  name        String
  description String?
  scope       RoleScope @default(PLATFORM)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @map("_id")
  key         String @unique
  description String
  group       String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid(7)) @map("_id")
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// A role grant. organizationId NULL = platform-wide grant; otherwise the grant applies to that organisation only.
model UserRole {
  id             String        @id @default(uuid(7)) @map("_id")
  userId         String
  user           User          @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedById    String?
  grantedBy      User?         @relation("UserRoleGrantedBy", fields: [grantedById], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([userId, roleId, organizationId])
  @@index([organizationId])
  @@map("user_roles")
}

model OrganizationDocument {
  id             String          @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docType        OrgDocumentType
  title          String
  fileId         String
  file           StoredFile      @relation(fields: [fileId], references: [id])
  status         ApprovalStatus  @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?           @relation("OrgDocReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@map("organization_documents")
}

/// Registry of every uploaded object. PRIVATE files are only reachable through short-lived signed URLs.
model StoredFile {
  id             String         @id @default(uuid(7)) @map("_id")
  storageKey     String         @unique
  visibility     FileVisibility
  fileName       String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  width          Int?
  height         Int?
  purpose        String
  uploadedById   String?
  uploadedBy     User?          @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  orgDocuments      OrganizationDocument[]
  propertyDocuments PropertyDocument[]
  projectDocuments  ProjectDocument[]
  employeeDocuments EmployeeDocument[]
  cmsMedia          CmsMedia[]
  expenses          Expense[]
  reimbursements    Reimbursement[]

  @@index([organizationId])
  @@map("stored_files")
}

/// Contents of uploaded files when STORAGE_DRIVER=database (photos and documents kept in MongoDB itself).
/// Stored in parts because one MongoDB document holds at most 16 MB.
model StoredFileChunk {
  id         String         @id @default(uuid(7)) @map("_id")
  storageKey String
  visibility FileVisibility
  mimeType   String
  part       Int
  data       Bytes
  createdAt  DateTime       @default(now())

  @@unique([storageKey, part])
  @@map("stored_file_chunks")
}

// ═════════════════════════ Locations ═════════════════════════

model Country {
  id        String   @id @default(uuid(7)) @map("_id")
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  states State[]

  @@map("countries")
}

model State {
  id        String   @id @default(uuid(7)) @map("_id")
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String
  slug      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cities     City[]
  properties Property[]
  projects   Project[]

  @@unique([countryId, slug])
  @@map("states")
}

model City {
  id         String   @id @default(uuid(7)) @map("_id")
  stateId    String
  state      State    @relation(fields: [stateId], references: [id])
  name       String
  slug       String   @unique
  latitude   Float?
  longitude  Float?
  /// Only active cities are offered in the marketplace (multi-city expansion switch)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  localities          Locality[]
  properties          Property[]
  projects            Project[]
  organizations       Organization[]
  leads               Lead[]
  customerPreferences CustomerPreference[]
  commissionRules     CommissionRule[]

  @@map("cities")
}

model Locality {
  id          String   @id @default(uuid(7)) @map("_id")
  cityId      String
  city        City     @relation(fields: [cityId], references: [id])
  name        String
  slug        String
  pincode     String?
  latitude    Float?
  longitude   Float?
  description String?
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]
  projects   Project[]
  leads      Lead[]

  @@unique([cityId, slug])
  @@index([pincode])
  @@map("localities")
}

// ═════════════════════════ Catalogue ═════════════════════════

/// Admin-managed property types (dynamic categories) grouped under a fixed segment.
model PropertyType {
  id          String          @id @default(uuid(7)) @map("_id")
  segment     PropertySegment
  name        String
  slug        String          @unique
  description String?
  formProfile FormProfile
  /// Which listing types this property type supports
  allowSale   Boolean         @default(true)
  allowRent   Boolean         @default(true)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  properties      Property[]
  commissionRules CommissionRule[]

  @@index([segment, isActive])
  @@map("property_types")
}

model Amenity {
  id            String   @id @default(uuid(7)) @map("_id")
  name          String
  slug          String   @unique
  /// Lucide icon name rendered by the UI
  icon          String?
  category      String   @default("General")
  forProperties Boolean  @default(true)
  forProjects   Boolean  @default(true)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  properties PropertyAmenity[]
  projects   ProjectAmenity[]

  @@map("amenities")
}

// ═════════════════════════ Marketplace: properties ═════════════════════════

model Property {
  id             String          @id @default(uuid(7)) @map("_id")
  referenceCode  String          @unique
  slug           String          @unique
  title          String
  description    String
  propertyTypeId String
  propertyType   PropertyType    @relation(fields: [propertyTypeId], references: [id])
  segment        PropertySegment
  listingType    ListingType
  sourceType     ListingSource
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  listedById     String
  listedBy       User            @relation("PropertyListedBy", fields: [listedById], references: [id])
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  /// Private owner contact (never exposed publicly)
  ownerName      String?
  ownerPhone     String?
  ownerEmail     String?

  // Location
  stateId           String
  state             State    @relation(fields: [stateId], references: [id])
  cityId            String
  city              City     @relation(fields: [cityId], references: [id])
  localityId        String
  locality          Locality @relation(fields: [localityId], references: [id])
  addressLine       String?
  landmark          String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  /// Maintained by trigger from latitude/longitude (PostGIS)
  location          Json? // GeoJSON Point { type, coordinates: [lng, lat] } — 2dsphere index by IndexesService
  /// Hide the exact address/pin publicly (only locality shown)
  hideExactLocation Boolean  @default(false)

  // Size & price
  area               Float
  areaUnit           AreaUnit
  /// Area normalised to square feet for search/sort
  areaSqft           Float
  carpetAreaSqft     Float?
  builtUpAreaSqft    Float?
  superAreaSqft      Float?
  plotAreaSqft       Float?
  /// Sale price, or monthly rent for RENT listings
  price              Float
  pricePerSqft       Float?
  priceNegotiable    Boolean  @default(false)
  maintenanceMonthly Float?
  securityDeposit    Float?
  bookingAmount      Float?

  // Category-specific core attributes (applicability defined by FormProfile)
  bedrooms          Int?
  bathrooms         Int?
  balconies         Int?
  furnishing        Furnishing?
  floorNumber       Int?
  totalFloors       Int?
  facing            Facing?
  possessionStatus  PossessionStatus?
  availableFrom     DateTime?
  ageYears          Int?
  plotLengthFt      Float?
  plotWidthFt       Float?
  roadWidthFt       Float?
  isCornerPlot      Boolean?
  ownershipType     OwnershipType?
  approvalAuthority String?
  reraNumber        String?
  coveredParking    Int?
  openParking       Int?
  /// Validated profile-specific extras (e.g. soil type, power load)
  attributes        Json              @default("{}")
  highlights        String[]          @default([])

  // Lifecycle
  status             PropertyStatus     @default(DRAFT)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  availability       Availability       @default(AVAILABLE)
  rejectionReason    String?
  isFeatured         Boolean            @default(false)
  featuredUntil      DateTime?
  submittedAt        DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  expiresAt          DateTime?
  closedAt           DateTime?
  coverImageUrl      String?
  viewCount          Int                @default(0)
  enquiryCount       Int                @default(0)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  media         PropertyMedia[]
  documents     PropertyDocument[]
  amenities     PropertyAmenity[]
  statusHistory PropertyStatusHistory[]
  favourites    PropertyFavourite[]
  reports       PropertyReport[]
  enquiries     Enquiry[]
  leads         Lead[]
  siteVisits    SiteVisit[]
  deals         Deal[]

  @@index([status, cityId, listingType, propertyTypeId])
  @@index([status, localityId])
  @@index([status, price])
  @@index([status, areaSqft])
  @@index([status, publishedAt])
  @@index([organizationId, status])
  @@index([projectId])
  @@map("properties")
}

model PropertyMedia {
  id         String    @id @default(uuid(7)) @map("_id")
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String
  storageKey String?
  caption    String?
  sortOrder  Int       @default(0)
  isCover    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([propertyId, sortOrder])
  @@map("property_media")
}

model PropertyDocument {
  id         String               @id @default(uuid(7)) @map("_id")
  propertyId String
  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  docType    PropertyDocumentType
  title      String
  fileId     String
  file       StoredFile           @relation(fields: [fileId], references: [id])
  visibility DocumentVisibility   @default(PRIVATE)
  verifiedAt DateTime?
  createdAt  DateTime             @default(now())

  @@index([propertyId])
  @@map("property_documents")
}

model PropertyAmenity {
  id         String   @id @default(uuid(7)) @map("_id")
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

model PropertyStatusHistory {
  id          String          @id @default(uuid(7)) @map("_id")
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStatus  PropertyStatus?
  toStatus    PropertyStatus
  reason      String?
  changedById String?
  changedBy   User?           @relation("PropertyStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([propertyId, createdAt])
  @@map("property_status_history")
}

model PropertyFavourite {
  id         String   @id @default(uuid(7)) @map("_id")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("property_favourites")
}

model PropertyReport {
  id            String       @id @default(uuid(7)) @map("_id")
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reason        ReportReason
  details       String?
  reporterId    String?
  reporter      User?        @relation("PropertyReportReporter", fields: [reporterId], references: [id])
  reporterEmail String?
  status        ReportStatus @default(OPEN)
  resolution    String?
  resolvedById  String?
  resolvedBy    User?        @relation("PropertyReportResolver", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@map("property_reports")
}

// ═════════════════════════ Brokers & developers ═════════════════════════

model BrokerProfile {
  id                 String             @id @default(uuid(7)) @map("_id")
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  displayName        String
  reraAgentNumber    String?
  experienceYears    Int?
  languages          String[]           @default([])
  specializations    String[]           @default([])
  about              String?
  verificationStatus VerificationStatus @default(PENDING)
  isFeatured         Boolean            @default(false)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@map("broker_profiles")
}

model DeveloperProfile {
  id                String       @id @default(uuid(7)) @map("_id")
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishedYear   Int?
  /// Self-declared by the developer (displayed as such)
  projectsDelivered Int?
  about             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("developer_profiles")
}

/// Admin-managed broker subscription plans (no prices are hard-coded).
model SubscriptionPlan {
  id            String        @id @default(uuid(7)) @map("_id")
  code          String        @unique
  name          String
  description   String?
  price         Float
  billingPeriod BillingPeriod
  /// Maximum concurrently active listings (null = unlimited)
  listingQuota  Int?
  featuredQuota Int?
  features      String[]      @default([])
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

model OrganizationSubscription {
  id               String             @id @default(uuid(7)) @map("_id")
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(PENDING)
  startsAt         DateTime
  endsAt           DateTime
  amount           Float
  /// Manual payment reference (no online gateway in v1)
  paymentReference String?
  notes            String?
  createdById      String?
  createdBy        User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([organizationId, status])
  @@map("broker_subscriptions")
}

// ═════════════════════════ Projects ═════════════════════════

model Project {
  id                String        @id @default(uuid(7)) @map("_id")
  slug              String        @unique
  name              String
  tagline           String?
  projectType       ProjectType
  organizationId    String
  organization      Organization  @relation("ProjectManagingOrg", fields: [organizationId], references: [id])
  developerOrgId    String?
  developerOrg      Organization? @relation("ProjectDeveloperOrg", fields: [developerOrgId], references: [id])
  stateId           String
  state             State         @relation(fields: [stateId], references: [id])
  cityId            String
  city              City          @relation(fields: [cityId], references: [id])
  localityId        String
  locality          Locality      @relation(fields: [localityId], references: [id])
  addressLine       String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  location          Json? // GeoJSON Point { type, coordinates: [lng, lat] } — 2dsphere index by IndexesService
  description       String
  heroImageUrl      String?
  logoUrl           String?
  masterPlanUrl     String?
  videoUrls         String[]      @default([])
  totalAreaAcres    Float?
  totalUnitsPlanned Int?
  launchDate        DateTime?
  possessionDate    DateTime?
  /// Optional manual price range shown when inventory is not yet released
  priceMinOverride  Float?
  priceMaxOverride  Float?
  reraNumber        String?
  reraValidUntil    DateTime?
  approvalDetails   String?
  legalInformation  String?
  // Lifecycle (server is the source of truth)
  status            ProjectStatus @default(DRAFT)
  /// When true the scheduler derives status from booking timestamps and inventory
  autoStatus        Boolean       @default(true)
  bookingOpensAt    DateTime?
  bookingClosesAt   DateTime?
  closingSoonHours  Int           @default(72)
  reviewStatus      ReviewStatus  @default(NOT_SUBMITTED)
  reviewNote        String?
  isPublished       Boolean       @default(false)
  publishedAt       DateTime?
  isFeatured        Boolean       @default(false)
  whatsappNumber    String?
  salesPhone        String?
  // SEO
  seoTitle          String?
  seoDescription    String?
  ogImageUrl        String?
  isDemo            Boolean       @default(false)
  createdById       String?
  createdBy         User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  statusHistory       ProjectStatusHistory[]
  media               ProjectMedia[]
  documents           ProjectDocument[]
  amenities           ProjectAmenity[]
  nearbyPlaces        ProjectNearbyPlace[]
  faqs                ProjectFaq[]
  constructionUpdates ProjectConstructionUpdate[]
  team                ProjectTeamMember[]
  blocks              ProjectBlock[]
  units               ProjectUnit[]
  domains             ProjectDomain[]
  page                ProjectPage?
  pageRevisions       ProjectPageRevision[]
  properties          Property[]
  enquiries           Enquiry[]
  leads               Lead[]
  siteVisits          SiteVisit[]
  deals               Deal[]
  assignmentRules     AssignmentRule[]
  commissionRules     CommissionRule[]

  @@index([status, cityId])
  @@index([isPublished, status])
  @@index([organizationId])
  @@index([developerOrgId])
  @@map("projects")
}

model ProjectStatusHistory {
  id          String         @id @default(uuid(7)) @map("_id")
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus  ProjectStatus?
  toStatus    ProjectStatus
  reason      String?
  /// NULL when changed by the scheduler
  changedById String?
  changedBy   User?          @relation("ProjectStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([projectId, createdAt])
  @@map("project_status_history")
}

model ProjectMedia {
  id         String    @id @default(uuid(7)) @map("_id")
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String
  storageKey String?
  caption    String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([projectId, type, sortOrder])
  @@map("project_images")
}

model ProjectDocument {
  id         String               @id @default(uuid(7)) @map("_id")
  projectId  String
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType    PropertyDocumentType
  title      String
  fileId     String
  file       StoredFile           @relation(fields: [fileId], references: [id])
  visibility DocumentVisibility   @default(PRIVATE)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())

  @@index([projectId])
  @@map("project_documents")
}

model ProjectAmenity {
  id        String  @id @default(uuid(7)) @map("_id")
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([projectId, amenityId])
  @@map("project_amenities")
}

model ProjectNearbyPlace {
  id            String         @id @default(uuid(7)) @map("_id")
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      NearbyCategory
  name          String
  distanceKm    Float
  travelMinutes Int?
  sortOrder     Int            @default(0)

  @@index([projectId])
  @@map("project_nearby_places")
}

model ProjectFaq {
  id        String  @id @default(uuid(7)) @map("_id")
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int     @default(0)

  @@index([projectId])
  @@map("project_faqs")
}

model ProjectConstructionUpdate {
  id              String   @id @default(uuid(7)) @map("_id")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  progressPercent Int?
  updateDate      DateTime
  imageUrls       String[] @default([])
  createdAt       DateTime @default(now())

  @@index([projectId, updateDate])
  @@map("project_construction_updates")
}

model ProjectTeamMember {
  id               String          @id @default(uuid(7)) @map("_id")
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             ProjectTeamRole @default(SALES_EXECUTIVE)
  isPrimaryContact Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@unique([projectId, userId])
  @@map("project_team_members")
}

model ProjectBlock {
  id          String    @id @default(uuid(7)) @map("_id")
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        BlockType @default(BLOCK)
  totalFloors Int?
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  units ProjectUnit[]

  @@unique([projectId, name])
  @@map("project_blocks")
}

model ProjectUnit {
  id                String        @id @default(uuid(7)) @map("_id")
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockId           String?
  block             ProjectBlock? @relation(fields: [blockId], references: [id])
  /// Unique within the project, e.g. "A-101" or "PLOT-27"
  code              String
  unitType          UnitType
  floorNumber       Int?
  configuration     String?
  bedrooms          Int?
  area              Float
  areaUnit          AreaUnit
  areaSqft          Float
  carpetAreaSqft    Float?
  facing            Facing?
  dimensions        String?
  isCorner          Boolean       @default(false)
  basePrice         Float
  /// Preferential location charges and other charges
  additionalCharges Float         @default(0)
  totalPrice        Float
  status            UnitStatus    @default(AVAILABLE)
  holdExpiresAt     DateTime?
  notes             String?
  /// Optimistic concurrency token for reservation/booking transitions
  version           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  history      UnitStatusHistory[]
  reservations UnitReservation[]
  enquiries    Enquiry[]
  leads        Lead[]
  siteVisits   SiteVisit[]
  deals        Deal[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@map("project_units")
}

model UnitStatusHistory {
  id          String      @id @default(uuid(7)) @map("_id")
  unitId      String
  unit        ProjectUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fromStatus  UnitStatus?
  toStatus    UnitStatus
  reason      String?
  leadId      String?
  priceBefore Float?
  priceAfter  Float?
  changedById String?
  changedBy   User?       @relation("UnitStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([unitId, createdAt])
  @@map("project_booking_history")
}

model UnitReservation {
  id           String            @id @default(uuid(7)) @map("_id")
  unitId       String
  unit         ProjectUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?             @relation(fields: [leadId], references: [id])
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id])
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime?
  notes        String?
  reservedById String?
  reservedBy   User?             @relation("UnitReservedBy", fields: [reservedById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([unitId, status])
  @@map("project_reservations")
}

model ProjectDomain {
  id                 String       @id @default(uuid(7)) @map("_id")
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  /// Normalised (lower-case, punycode, no trailing dot, no port)
  hostname           String       @unique
  type               DomainType
  isPrimary          Boolean      @default(false)
  status             DomainStatus @default(PENDING_VERIFICATION)
  verificationToken  String
  /// DNS TXT record name the owner must create
  verificationRecord String
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  lastError          String?
  dnsTargetOk        Boolean      @default(false)
  sslStatus          SslStatus    @default(NOT_REQUESTED)
  enabledAt          DateTime?
  disabledAt         DateTime?
  createdById        String?
  createdBy          User?        @relation("DomainCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("project_domains")
}

/// Structured, validated page-builder document for a project microsite (draft + published copies).
model ProjectPage {
  id                String    @id @default(uuid(7)) @map("_id")
  projectId         String    @unique
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draftSections     Json      @default("[]")
  publishedSections Json?
  draftUpdatedAt    DateTime  @default(now())
  publishedAt       DateTime?
  publishedById     String?
  publishedBy       User?     @relation("PagePublishedBy", fields: [publishedById], references: [id])
  revision          Int       @default(0)
  /// Random token allowing a time-limited draft preview without publishing
  previewToken      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("project_pages")
}

model ProjectPageRevision {
  id            String   @id @default(uuid(7)) @map("_id")
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision      Int
  sections      Json
  publishedById String?
  publishedBy   User?    @relation("PageRevisionBy", fields: [publishedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([projectId, revision])
  @@map("project_page_revisions")
}

// ═════════════════════════ CRM ═════════════════════════

/// Customers are tenant-scoped: each organisation keeps its own CRM record of a person.
model Customer {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation("CustomerUser", fields: [userId], references: [id])
  fullName       String
  /// E.164 normalised
  phone          String?
  email          String?
  alternatePhone String?
  city           String?
  occupation     String?
  notes          String?
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  preferences  CustomerPreference[]
  enquiries    Enquiry[]
  leads        Lead[]
  siteVisits   SiteVisit[]
  deals        Deal[]
  reservations UnitReservation[]
  invoices     Invoice[]

  // unique (organizationId, phone) when phone is set — partial index in IndexesService
  @@index([organizationId, email])
  @@index([userId])
  @@map("customers")
}

model CustomerPreference {
  id            String           @id @default(uuid(7)) @map("_id")
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listingType   ListingType?
  segment       PropertySegment?
  cityId        String?
  city          City?            @relation(fields: [cityId], references: [id])
  localityNames String[]         @default([])
  budgetMin     Float?
  budgetMax     Float?
  bedroomsMin   Int?
  notes         String?
  createdAt     DateTime         @default(now())

  @@index([customerId])
  @@map("customer_preferences")
}

model Enquiry {
  id                String        @id @default(uuid(7)) @map("_id")
  referenceNo       String        @unique
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  type              EnquiryType
  status            EnquiryStatus @default(NEW)
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  name              String
  phone             String
  email             String?
  message           String?
  propertyId        String?
  property          Property?     @relation(fields: [propertyId], references: [id])
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id])
  unitId            String?
  unit              ProjectUnit?  @relation(fields: [unitId], references: [id])
  preferredDate     DateTime?
  preferredTimeSlot String?
  sourceKey         String        @default("WEBSITE")
  sourcePage        String?
  sourceHost        String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  referrer          String?
  ipHash            String?
  userAgent         String?
  consent           Boolean       @default(false)
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id])
  spamReason        String?
  isDemo            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, createdAt])
  @@index([phone])
  @@index([status])
  @@map("enquiries")
}

model LeadSource {
  id        String   @id @default(uuid(7)) @map("_id")
  key       String   @unique
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  leads Lead[]

  @@map("lead_sources")
}

model LeadProvider {
  id                  String             @id @default(uuid(7)) @map("_id")
  /// The provider's own organisation (members are provider users)
  organizationId      String             @unique
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  contactName         String?
  email               String?
  phone               String?
  status              LeadProviderStatus @default(ACTIVE)
  /// Leads must be at least this many days apart to not count as duplicates
  duplicateWindowDays Int                @default(90)
  apiKeyPrefix        String?
  apiKeyHash          String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  leads             Lead[]
  commissionRules   CommissionRule[]
  commissionRecords CommissionRecord[]
  payouts           CommissionPayout[]
  deals             Deal[]

  @@map("lead_providers")
}

enum LeadProviderStatus {
  ACTIVE
  SUSPENDED
}

model Campaign {
  id             String         @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  channel        String
  status         CampaignStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leads Lead[]

  @@unique([organizationId, code])
  @@map("campaigns")
}

model Lead {
  id                  String           @id @default(uuid(7)) @map("_id")
  leadNo              String           @unique
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id])
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id])
  name                String
  phone               String
  email               String?
  sourceId            String
  source              LeadSource       @relation(fields: [sourceId], references: [id])
  leadProviderId      String?
  leadProvider        LeadProvider?    @relation(fields: [leadProviderId], references: [id])
  campaignId          String?
  campaign            Campaign?        @relation(fields: [campaignId], references: [id])
  propertyId          String?
  property            Property?        @relation(fields: [propertyId], references: [id])
  projectId           String?
  project             Project?         @relation(fields: [projectId], references: [id])
  unitId              String?
  unit                ProjectUnit?     @relation(fields: [unitId], references: [id])
  enquiryType         EnquiryType      @default(GENERAL)
  listingType         ListingType?
  budgetMin           Float?
  budgetMax           Float?
  preferredCityId     String?
  preferredCity       City?            @relation(fields: [preferredCityId], references: [id])
  preferredLocalityId String?
  preferredLocality   Locality?        @relation(fields: [preferredLocalityId], references: [id])
  locationPreference  String?
  requirement         String?
  status              LeadStatus       @default(NEW)
  priority            LeadPriority     @default(MEDIUM)
  intakeStatus        LeadIntakeStatus @default(ACCEPTED)
  intakeNote          String?
  isDuplicate         Boolean          @default(false)
  duplicateOfId       String?
  duplicateOf         Lead?            @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates          Lead[]           @relation("LeadDuplicates")
  assignedToId        String?
  assignedTo          User?            @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  assignedTeamId      String?
  assignedTeam        SalesTeam?       @relation(fields: [assignedTeamId], references: [id])
  assignedAt          DateTime?
  nextFollowUpAt      DateTime?
  lastContactedAt     DateTime?
  lostReason          String?
  convertedAt         DateTime?
  tags                String[]         @default([])
  createdById         String?
  createdBy           User?            @relation("LeadCreatedBy", fields: [createdById], references: [id])
  isDemo              Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  enquiries    Enquiry[]
  assignments  LeadAssignment[]
  activities   LeadActivity[]
  followUps    LeadFollowUp[]
  siteVisits   SiteVisit[]
  deals        Deal[]
  reservations UnitReservation[]
  tasks        EmployeeTask[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([assignedToId, status])
  @@index([phone])
  @@index([nextFollowUpAt])
  @@index([leadProviderId, intakeStatus])
  @@map("leads")
}

/// Ordered, tenant-scoped rules for automatic lead assignment.
model AssignmentRule {
  id                  String             @id @default(uuid(7)) @map("_id")
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id])
  name                String
  priority            Int                @default(100)
  isActive            Boolean            @default(true)
  // Match conditions (all provided conditions must match)
  matchProjectId      String?
  matchProject        Project?           @relation(fields: [matchProjectId], references: [id])
  matchCityIds        String[]           @default([])
  matchLocalityIds    String[]           @default([])
  matchSourceKeys     String[]           @default([])
  matchListingType    ListingType?
  // Assignment
  salesTeamId         String
  salesTeam           SalesTeam          @relation(fields: [salesTeamId], references: [id])
  strategy            AssignmentStrategy @default(ROUND_ROBIN)
  /// Members with this many open leads are skipped (null = no cap)
  maxOpenLeadsPerUser Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  assignments LeadAssignment[]

  @@index([organizationId, isActive, priority])
  @@map("lead_assignment_rules")
}

model SalesTeam {
  id                 String       @id @default(uuid(7)) @map("_id")
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  description        String?
  managerId          String?
  manager            User?        @relation("SalesTeamManager", fields: [managerId], references: [id])
  /// Round-robin cursor: id of the member who most recently received a lead
  lastAssignedUserId String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  members         SalesTeamMember[]
  rules           AssignmentRule[]
  leads           Lead[]
  leadAssignments LeadAssignment[]

  @@unique([organizationId, name])
  @@map("sales_teams")
}

model SalesTeamMember {
  id       String    @id @default(uuid(7)) @map("_id")
  teamId   String
  team     SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean   @default(true)
  joinedAt DateTime  @default(now())

  @@unique([teamId, userId])
  @@map("sales_team_members")
}

model LeadAssignment {
  id           String           @id @default(uuid(7)) @map("_id")
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User             @relation("AssignmentAssignee", fields: [assignedToId], references: [id])
  /// NULL when assigned automatically by the engine
  assignedById String?
  assignedBy   User?            @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  teamId       String?
  team         SalesTeam?       @relation(fields: [teamId], references: [id])
  ruleId       String?
  rule         AssignmentRule?  @relation(fields: [ruleId], references: [id])
  method       AssignmentMethod
  reason       String?
  isCurrent    Boolean          @default(true)
  assignedAt   DateTime         @default(now())
  endedAt      DateTime?

  @@index([leadId, assignedAt])
  @@index([assignedToId, isCurrent])
  @@map("lead_assignments")
}

model LeadActivity {
  id              String             @id @default(uuid(7)) @map("_id")
  leadId          String
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            ActivityType
  direction       ActivityDirection?
  outcome         String?
  summary         String
  details         String?
  metadata        Json?
  durationSeconds Int?
  performedById   String?
  performedBy     User?              @relation("ActivityPerformer", fields: [performedById], references: [id])
  occurredAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

model LeadFollowUp {
  id             String         @id @default(uuid(7)) @map("_id")
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId   String
  assignedTo     User           @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  type           FollowUpType   @default(CALL)
  dueAt          DateTime
  status         FollowUpStatus @default(PENDING)
  notes          String?
  outcome        String?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdById    String?
  createdBy      User?          @relation("FollowUpCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([leadId])
  @@map("lead_followups")
}

model SiteVisit {
  id               String          @id @default(uuid(7)) @map("_id")
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  propertyId       String?
  property         Property?       @relation(fields: [propertyId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  unitId           String?
  unit             ProjectUnit?    @relation(fields: [unitId], references: [id])
  scheduledAt      DateTime
  status           SiteVisitStatus @default(SCHEDULED)
  assignedToId     String?
  assignedTo       User?           @relation("SiteVisitAssignee", fields: [assignedToId], references: [id])
  meetingPoint     String?
  notes            String?
  outcome          String?
  customerFeedback String?
  completedAt      DateTime?
  createdById      String?
  createdBy        User?           @relation("SiteVisitCreator", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([assignedToId, scheduledAt])
  @@index([leadId])
  @@index([status, scheduledAt])
  @@map("site_visits")
}

/// A booking / deal recorded manually by the sales team (no online payments in v1).
model Deal {
  id                   String        @id @default(uuid(7)) @map("_id")
  dealNo               String        @unique
  organizationId       String
  organization         Organization  @relation("DealOrg", fields: [organizationId], references: [id])
  leadId               String?
  lead                 Lead?         @relation(fields: [leadId], references: [id])
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  propertyId           String?
  property             Property?     @relation(fields: [propertyId], references: [id])
  projectId            String?
  project              Project?      @relation(fields: [projectId], references: [id])
  unitId               String?
  unit                 ProjectUnit?  @relation(fields: [unitId], references: [id])
  dealType             DealType      @default(SALE)
  status               DealStatus    @default(OPEN)
  /// Agreed property deal value (not money received)
  dealValue            Float
  /// Expected company revenue (brokerage / margin) on this deal
  expectedRevenue      Float?
  bookingDate          DateTime?
  agreementDate        DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  salesUserId          String?
  salesUser            User?         @relation("DealSalesUser", fields: [salesUserId], references: [id])
  brokerOrganizationId String?
  brokerOrganization   Organization? @relation("DealBrokerOrg", fields: [brokerOrganizationId], references: [id])
  leadProviderId       String?
  leadProvider         LeadProvider? @relation(fields: [leadProviderId], references: [id])
  notes                String?
  createdById          String?
  createdBy            User?         @relation("DealCreatedBy", fields: [createdById], references: [id])
  isDemo               Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payments          DealPayment[]
  commissionRecords CommissionRecord[]
  invoices          Invoice[]
  transactions      FinanceTransaction[]

  @@index([organizationId, status])
  @@index([salesUserId])
  @@map("deals")
}

/// Customer money received against a deal — tracked separately from company revenue.
model DealPayment {
  id           String          @id @default(uuid(7)) @map("_id")
  dealId       String
  deal         Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount       Float
  receivedOn   DateTime
  receivedBy   PaymentReceiver @default(DEVELOPER)
  method       PaymentMethod
  referenceNo  String?
  notes        String?
  recordedById String?
  recordedBy   User?           @relation("DealPaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([dealId])
  @@map("deal_payments")
}

// ═════════════════════════ Employees & HR ═════════════════════════

model Department {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  description    String?
  parentId       String?
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Department[] @relation("DepartmentTree")
  headEmployeeId String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees    Employee[]
  designations Designation[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Designation {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  name           String
  level          Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  employees Employee[]

  @@unique([organizationId, name])
  @@map("designations")
}

model Employee {
  id                   String           @id @default(uuid(7)) @map("_id")
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id])
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id])
  employeeCode         String
  departmentId         String?
  department           Department?      @relation(fields: [departmentId], references: [id])
  designationId        String?
  designation          Designation?     @relation(fields: [designationId], references: [id])
  managerId            String?
  manager              Employee?        @relation("ReportingLine", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports              Employee[]       @relation("ReportingLine")
  shiftId              String?
  shift                Shift?           @relation(fields: [shiftId], references: [id])
  joiningDate          DateTime
  exitDate             DateTime?
  employmentType       EmploymentType   @default(FULL_TIME)
  employmentStatus     EmploymentStatus @default(ACTIVE)
  workLocation         String?
  dateOfBirth          DateTime?
  gender               String?
  personalEmail        String?
  emergencyContact     String?
  /// AES-256-GCM encrypted at rest (DATA_ENCRYPTION_KEY)
  bankDetailsEncrypted String?
  bankAccountLast4     String?
  panEncrypted         String?
  isDemo               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  documents             EmployeeDocument[]
  attendance            AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  salaryStructures      SalaryStructure[]
  payslips              Payslip[]
  adjustments           PayrollAdjustment[]
  reimbursements        Reimbursement[]

  @@unique([organizationId, employeeCode])
  @@index([managerId])
  @@index([departmentId])
  @@map("employees")
}

model EmployeeDocument {
  id           String               @id @default(uuid(7)) @map("_id")
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docType      EmployeeDocumentType
  title        String
  fileId       String
  file         StoredFile           @relation(fields: [fileId], references: [id])
  uploadedById String?
  uploadedBy   User?                @relation("EmpDocUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime             @default(now())

  @@index([employeeId])
  @@map("employee_documents")
}

model Shift {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  /// Local wall-clock times "HH:mm" in the shift timezone
  startTime      String
  endTime        String
  graceMinutes   Int          @default(15)
  /// Minimum worked minutes for a full day; below halfDayMinutes counts as absent
  fullDayMinutes Int          @default(480)
  halfDayMinutes Int          @default(240)
  /// 0 = Sunday … 6 = Saturday
  weeklyOffDays  Int[]        @default([0])
  timezone       String       @default("Asia/Kolkata")
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@unique([organizationId, name])
  @@map("shifts")
}

model Holiday {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime
  name           String
  isOptional     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
  @@map("holidays")
}

model AttendanceRecord {
  id          String           @id @default(uuid(7)) @map("_id")
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  status      AttendanceStatus
  isLate      Boolean          @default(false)
  workMinutes Int              @default(0)
  source      AttendanceSource @default(WEB)
  checkInIp   String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model AttendanceCorrection {
  id                String            @id @default(uuid(7)) @map("_id")
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceId      String?
  attendance        AttendanceRecord? @relation(fields: [attendanceId], references: [id])
  date              DateTime
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            ApprovalStatus    @default(PENDING)
  reviewedById      String?
  reviewedBy        User?             @relation("AttCorrectionReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime          @default(now())

  @@index([employeeId, status])
  @@map("attendance_corrections")
}

model LeaveType {
  id              String       @id @default(uuid(7)) @map("_id")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  code            String
  isPaid          Boolean      @default(true)
  annualQuota     Float
  carryForward    Boolean      @default(false)
  maxCarryForward Float?
  allowHalfDay    Boolean      @default(true)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([organizationId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid(7)) @map("_id")
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  allocated      Float
  carriedForward Float     @default(0)
  used           Float     @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String         @id @default(uuid(7)) @map("_id")
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType      @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  halfDayStart Boolean        @default(false)
  halfDayEnd   Boolean        @default(false)
  days         Float
  reason       String
  status       ApprovalStatus @default(PENDING)
  approverId   String?
  approver     User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([employeeId, status])
  @@index([status, startDate])
  @@map("leave_requests")
}

model EmployeeTask {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  assignedToId   String
  assignedTo     User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  dueAt          DateTime?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assignedToId, status])
  @@map("employee_tasks")
}

// ═════════════════════════ Payroll ═════════════════════════

/// Configurable salary components. Formulas are documented in docs/workflows/payroll.md.
model SalaryComponent {
  id                  String              @id @default(uuid(7)) @map("_id")
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id])
  code                String
  name                String
  type                SalaryComponentType
  calcType            SalaryCalcType      @default(FIXED)
  /// Default amount (FIXED) or percentage (PERCENT_OF_*) used when a structure line omits a value
  defaultValue        Float?
  /// Optional monthly cap applied after calculation
  maxAmount           Float?
  isStatutory         Boolean             @default(false)
  isTaxable           Boolean             @default(true)
  prorateByAttendance Boolean             @default(true)
  description         String?
  sortOrder           Int                 @default(0)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  structureLines SalaryStructureLine[]

  @@unique([organizationId, code])
  @@map("salary_components")
}

model SalaryStructure {
  id            String    @id @default(uuid(7)) @map("_id")
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  notes         String?
  createdById   String?
  createdBy     User?     @relation("SalaryStructureCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  lines    SalaryStructureLine[]
  payslips Payslip[]

  @@index([employeeId, isActive])
  @@map("salary_structures")
}

model SalaryStructureLine {
  id          String          @id @default(uuid(7)) @map("_id")
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id])
  /// Monthly amount for FIXED components, percentage for PERCENT_OF_* components
  value       Float

  @@unique([structureId, componentId])
  @@map("salary_structure_components")
}

model PayrollRun {
  id              String        @id @default(uuid(7)) @map("_id")
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  periodYear      Int
  periodMonth     Int
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollStatus @default(DRAFT)
  workingDays     Int           @default(0)
  totalGross      Float         @default(0)
  totalDeductions Float         @default(0)
  totalNet        Float         @default(0)
  notes           String?
  createdById     String?
  createdBy       User?         @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  calculatedById  String?
  calculatedBy    User?         @relation("PayrollCalculatedBy", fields: [calculatedById], references: [id])
  calculatedAt    DateTime?
  approvedById    String?
  approvedBy      User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payslips    Payslip[]
  adjustments PayrollAdjustment[]

  @@index([organizationId, periodYear, periodMonth])
  @@map("payroll_runs")
}

model Payslip {
  id              String           @id @default(uuid(7)) @map("_id")
  payrollRunId    String
  payrollRun      PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  structureId     String?
  structure       SalaryStructure? @relation(fields: [structureId], references: [id])
  workingDays     Float
  payableDays     Float
  lopDays         Float
  grossEarnings   Float
  totalDeductions Float
  netPay          Float
  status          PayslipStatus    @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines    PayslipLine[]
  payments SalaryPayment[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

model PayslipLine {
  id            String              @id @default(uuid(7)) @map("_id")
  payslipId     String
  payslip       Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentCode String
  componentName String
  type          SalaryComponentType
  amount        Float
  /// Human-readable explanation of how the amount was calculated
  calculation   String
  sortOrder     Int                 @default(0)

  @@index([payslipId])
  @@map("payslip_lines")
}

model SalaryPayment {
  id           String        @id @default(uuid(7)) @map("_id")
  payslipId    String
  payslip      Payslip       @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  amount       Float
  paidOn       DateTime
  method       PaymentMethod
  referenceNo  String?
  notes        String?
  recordedById String?
  recordedBy   User?         @relation("SalaryPaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  transactions FinanceTransaction[]

  @@index([payslipId])
  @@map("salary_payments")
}

/// One-off additions/deductions for a payroll period (incentives, bonuses, recoveries).
model PayrollAdjustment {
  id           String                @id @default(uuid(7)) @map("_id")
  employeeId   String
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodYear   Int
  periodMonth  Int
  type         PayrollAdjustmentType
  amount       Float
  description  String
  /// e.g. "COMMISSION:<commissionRecordId>" when generated from a commission
  sourceRef    String?
  status       AdjustmentStatus      @default(PENDING)
  payrollRunId String?
  payrollRun   PayrollRun?           @relation(fields: [payrollRunId], references: [id])
  createdById  String?
  createdBy    User?                 @relation("AdjustmentCreator", fields: [createdById], references: [id])
  createdAt    DateTime              @default(now())

  @@index([employeeId, periodYear, periodMonth])
  @@map("payroll_adjustments")
}

// ═════════════════════════ Commissions ═════════════════════════

/// Configurable commission rules. No rates are hard-coded.
model CommissionRule {
  id                   String                  @id @default(uuid(7)) @map("_id")
  organizationId       String
  organization         Organization            @relation("CommissionRuleOrg", fields: [organizationId], references: [id])
  name                 String
  recipientType        CommissionRecipientType
  calcType             CommissionCalcType
  /// Fixed amount (INR) or percentage depending on calcType
  value                Float
  basis                CommissionBasis         @default(DEAL_VALUE)
  dealType             DealType?
  projectId            String?
  project              Project?                @relation(fields: [projectId], references: [id])
  propertyTypeId       String?
  propertyType         PropertyType?           @relation(fields: [propertyTypeId], references: [id])
  cityId               String?
  city                 City?                   @relation(fields: [cityId], references: [id])
  leadProviderId       String?
  leadProvider         LeadProvider?           @relation(fields: [leadProviderId], references: [id])
  brokerOrganizationId String?
  brokerOrganization   Organization?           @relation("CommissionRuleBrokerOrg", fields: [brokerOrganizationId], references: [id])
  minDealValue         Float?
  maxPayout            Float?
  priority             Int                     @default(100)
  isActive             Boolean                 @default(true)
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  records CommissionRecord[]

  @@index([organizationId, isActive])
  @@map("commission_rules")
}

model CommissionRecord {
  id                      String                  @id @default(uuid(7)) @map("_id")
  organizationId          String
  organization            Organization            @relation("CommissionOrg", fields: [organizationId], references: [id])
  dealId                  String
  deal                    Deal                    @relation(fields: [dealId], references: [id])
  ruleId                  String?
  rule                    CommissionRule?         @relation(fields: [ruleId], references: [id])
  recipientType           CommissionRecipientType
  recipientUserId         String?
  recipientUser           User?                   @relation("CommissionRecipientUser", fields: [recipientUserId], references: [id])
  recipientOrganizationId String?
  recipientOrganization   Organization?           @relation("CommissionRecipientOrg", fields: [recipientOrganizationId], references: [id])
  leadProviderId          String?
  leadProvider            LeadProvider?           @relation(fields: [leadProviderId], references: [id])
  recipientName           String
  basisAmount             Float
  calcType                CommissionCalcType
  rate                    Float
  amount                  Float
  amountPaid              Float                   @default(0)
  status                  CommissionStatus        @default(PENDING_APPROVAL)
  approvedById            String?
  approvedBy              User?                   @relation("CommissionApprover", fields: [approvedById], references: [id])
  approvedAt              DateTime?
  notes                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  payoutItems CommissionPayoutItem[]

  @@index([organizationId, status])
  @@index([recipientUserId])
  @@index([recipientOrganizationId])
  @@index([leadProviderId])
  @@index([dealId])
  @@map("commission_records")
}

model CommissionPayout {
  id                      String                  @id @default(uuid(7)) @map("_id")
  payoutNo                String                  @unique
  organizationId          String
  organization            Organization            @relation("PayoutOrg", fields: [organizationId], references: [id])
  recipientType           CommissionRecipientType
  recipientUserId         String?
  recipientUser           User?                   @relation("PayoutRecipientUser", fields: [recipientUserId], references: [id])
  recipientOrganizationId String?
  recipientOrganization   Organization?           @relation("PayoutRecipientOrg", fields: [recipientOrganizationId], references: [id])
  leadProviderId          String?
  leadProvider            LeadProvider?           @relation(fields: [leadProviderId], references: [id])
  recipientName           String
  totalAmount             Float
  status                  PayoutStatus            @default(PENDING)
  method                  PaymentMethod?
  referenceNo             String?
  paidOn                  DateTime?
  notes                   String?
  recordedById            String?
  recordedBy              User?                   @relation("PayoutRecorder", fields: [recordedById], references: [id])
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  items        CommissionPayoutItem[]
  transactions FinanceTransaction[]

  @@index([organizationId, status])
  @@map("commission_payouts")
}

model CommissionPayoutItem {
  id                 String           @id @default(uuid(7)) @map("_id")
  payoutId           String
  payout             CommissionPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commissionRecordId String
  commissionRecord   CommissionRecord @relation(fields: [commissionRecordId], references: [id])
  amount             Float

  @@unique([payoutId, commissionRecordId])
  @@map("commission_payout_items")
}

// ═════════════════════════ Finance ═════════════════════════

/// Ledger of money actually moving in or out of the company.
model FinanceTransaction {
  id              String               @id @default(uuid(7)) @map("_id")
  txnNo           String               @unique
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id])
  type            TransactionType
  direction       TransactionDirection
  amount          Float
  txnDate         DateTime
  method          PaymentMethod
  referenceNo     String?
  counterparty    String?
  description     String?
  dealId          String?
  deal            Deal?                @relation(fields: [dealId], references: [id])
  invoiceId       String?
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id])
  expenseId       String?
  expense         Expense?             @relation(fields: [expenseId], references: [id])
  payoutId        String?
  payout          CommissionPayout?    @relation(fields: [payoutId], references: [id])
  salaryPaymentId String?
  salaryPayment   SalaryPayment?       @relation(fields: [salaryPaymentId], references: [id])
  reimbursementId String?
  reimbursement   Reimbursement?       @relation(fields: [reimbursementId], references: [id])
  recordedById    String?
  recordedBy      User?                @relation("TxnRecorder", fields: [recordedById], references: [id])
  createdAt       DateTime             @default(now())

  @@index([organizationId, txnDate])
  @@index([type])
  @@map("transactions")
}

model ExpenseCategory {
  id             String       @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  expenses Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id             String          @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount         Float
  expenseDate    DateTime
  vendor         String?
  description    String
  status         ExpenseStatus   @default(PENDING)
  receiptFileId  String?
  receiptFile    StoredFile?     @relation(fields: [receiptFileId], references: [id])
  createdById    String?
  createdBy      User?           @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions FinanceTransaction[]

  @@index([organizationId, expenseDate])
  @@map("expenses")
}

model Invoice {
  id                   String        @id @default(uuid(7)) @map("_id")
  invoiceNo            String        @unique
  organizationId       String
  organization         Organization  @relation("InvoiceIssuerOrg", fields: [organizationId], references: [id])
  billToName           String
  billToAddress        String?
  billToGstin          String?
  billToOrganizationId String?
  billToOrganization   Organization? @relation("InvoiceBillToOrg", fields: [billToOrganizationId], references: [id])
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])
  dealId               String?
  deal                 Deal?         @relation(fields: [dealId], references: [id])
  issueDate            DateTime
  dueDate              DateTime?
  status               InvoiceStatus @default(DRAFT)
  subtotal             Float
  taxTotal             Float
  total                Float
  amountPaid           Float         @default(0)
  notes                String?
  createdById          String?
  createdBy            User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lines        InvoiceLine[]
  transactions FinanceTransaction[]

  @@index([organizationId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid(7)) @map("_id")
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  /// Tax rate entered per line (configurable; never assumed)
  taxRate     Float   @default(0)
  amount      Float
  taxAmount   Float
  sortOrder   Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Reimbursement {
  id             String              @id @default(uuid(7)) @map("_id")
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee            @relation(fields: [employeeId], references: [id])
  title          String
  category       String
  amount         Float
  expenseDate    DateTime
  description    String?
  receiptFileId  String?
  receiptFile    StoredFile?         @relation(fields: [receiptFileId], references: [id])
  status         ReimbursementStatus @default(SUBMITTED)
  approverId     String?
  approver       User?               @relation("ReimbursementApprover", fields: [approverId], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  transactions FinanceTransaction[]

  @@index([employeeId, status])
  @@map("reimbursements")
}

// ═════════════════════════ CMS & SEO ═════════════════════════

model CmsPage {
  id             String        @id @default(uuid(7)) @map("_id")
  slug           String        @unique
  title          String
  /// Validated content blocks (see @estate/shared cms schemas) — never raw HTML
  blocks         Json          @default("[]")
  status         ContentStatus @default(DRAFT)
  showInFooter   Boolean       @default(false)
  footerGroup    String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImageUrl     String?
  noIndex        Boolean       @default(false)
  publishedAt    DateTime?
  updatedById    String?
  updatedBy      User?         @relation("CmsPageUpdater", fields: [updatedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("cms_pages")
}

/// Homepage (and other page) section configuration.
model CmsSection {
  id        String   @id @default(uuid(7)) @map("_id")
  pageKey   String
  type      String
  title     String?
  subtitle  String?
  config    Json     @default("{}")
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey, sortOrder])
  @@map("cms_sections")
}

model CmsBanner {
  id        String    @id @default(uuid(7)) @map("_id")
  placement String
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([placement, isActive])
  @@map("cms_banners")
}

model CmsMedia {
  id        String     @id @default(uuid(7)) @map("_id")
  fileId    String
  file      StoredFile @relation(fields: [fileId], references: [id])
  url       String
  altText   String?
  folder    String     @default("general")
  createdAt DateTime   @default(now())

  @@map("cms_media")
}

model Faq {
  id          String   @id @default(uuid(7)) @map("_id")
  category    String   @default("General")
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model SeoOverride {
  id           String   @id @default(uuid(7)) @map("_id")
  path         String   @unique
  title        String?
  description  String?
  canonicalUrl String?
  ogImageUrl   String?
  noIndex      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("seo_overrides")
}

// ═════════════════════════ Notifications ═════════════════════════

model NotificationTemplate {
  id        String              @id @default(uuid(7)) @map("_id")
  eventKey  String
  channel   NotificationChannel
  subject   String?
  /// Plain text with {{placeholders}}; rendered with escaping, never as HTML/JS
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([eventKey, channel])
  @@map("notification_templates")
}

model Notification {
  id        String    @id @default(uuid(7)) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey  String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Every outbound message attempt. Status reflects the provider's real response — never assumed.
model CommunicationLog {
  id                String              @id @default(uuid(7)) @map("_id")
  channel           NotificationChannel
  eventKey          String
  recipient         String
  recipientUserId   String?
  recipientUser     User?               @relation("CommRecipient", fields: [recipientUserId], references: [id])
  subject           String?
  body              String
  status            DeliveryStatus      @default(QUEUED)
  provider          String?
  providerMessageId String?
  attempts          Int                 @default(0)
  /// Outbox scheduling: when the next delivery attempt is due (NULL once final)
  nextAttemptAt     DateTime?           @default(now())
  lastError         String?
  relatedType       String?
  relatedId         String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
  @@index([relatedType, relatedId])
  @@map("communication_logs")
}

// ═════════════════════════ System ═════════════════════════

model AuditLog {
  id             String   @id @default(uuid(7)) @map("_id")
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorIp        String?
  action         String
  entityType     String
  entityId       String?
  /// Organisation context (no FK so the trail outlives the entity)
  organizationId String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @map("_id")
  value       Json
  group       String
  /// Public settings are exposed (read-only) to the public website
  isPublic    Boolean  @default(false)
  description String?
  updatedById String?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model FeatureFlag {
  key         String   @id @map("_id")
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

/// Atomic per-key counters for human-readable reference numbers (ENQ-2026-000123).
model ReferenceCounter {
  key   String @id @map("_id")
  value Int    @default(0)

  @@map("reference_counters")
}

/// Lease that keeps a scheduled job on one API instance at a time (PrismaService.withJobLock).
/// An instance that crashes mid-job loses the lease when expiresAt passes.
model JobLock {
  key       String   @id @map("_id")
  owner     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("job_locks")
}

/// Written inside a transaction to serialise transactions on the same key (lockInTransaction):
/// MongoDB aborts the later writer with a write conflict and PrismaService retries it.
model TransactionLock {
  key       String   @id @map("_id")
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("transaction_locks")
}
