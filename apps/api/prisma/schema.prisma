// ════════════════════════════════════════════════════════════════════════════
//  Estate platform — PostgreSQL schema (Prisma 7)
//  Conventions
//   • Tables are snake_case plurals (@@map); columns are camelCase (quote in raw SQL).
//   • UUID v7 primary keys (time-ordered → good index locality).
//   • Money: numeric(14,2) INR. Areas: numeric(14,2). Rates/percentages: numeric(9,4).
//   • All instants are timestamptz(3); calendar dates (attendance, leave) are date.
//   • Business entities that must never disappear use soft delete (deletedAt).
//   • Enum values mirror constants in @estate/shared (verified by a unit test).
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm]
}

