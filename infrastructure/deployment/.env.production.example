# Production deployment variables for docker-compose.prod.yml. Copy to `.env` next to the compose
# file and fill in. Never commit the real file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # DATA_ENCRYPTION_KEY

APP_ENV=production
WEB_DOMAIN=example-brand.in
CONSOLE_DOMAIN=console.example-brand.in
ACME_EMAIL=ops@example-brand.in

# Managed PostgreSQL (PostGIS extension required) — or the bundled postgres service
POSTGRES_USER=estate
POSTGRES_PASSWORD=
POSTGRES_DB=estate
DATABASE_URL=postgresql://estate:PASSWORD@postgres:5432/estate?schema=public&sslmode=disable
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
FILE_URL_SIGNING_SECRET=

# Custom project domains: hostname (or IPv4) that customers point their DNS at
CUSTOM_DOMAIN_CNAME_TARGET=sites.example-brand.in
CUSTOM_DOMAIN_A_RECORD=

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO…)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Notifications (leave blank → channel shows "not configured")
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
