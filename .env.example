# ────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (never commit `.env`). Values here are local-development
# placeholders only — generate fresh secrets for every real environment.
# ────────────────────────────────────────────────────────────────────────────

# Runtime environment: local | development | staging | production
APP_ENV=local
NODE_ENV=development

# ── Local infrastructure (docker-compose.yml) ───────────────────────────────
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380

# ── Database (MongoDB; must be a replica set — the local container is a single-node one) ──
# Production: the MongoDB Atlas "Drivers" connection string with the database name added, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basera?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27018/basera?directConnection=true
# Used only by the integration test-suite (dropped and rebuilt on every run; name must end in _test)
TEST_DATABASE_URL=mongodb://localhost:27018/basera_test?directConnection=true

# ── Redis / background jobs (optional: without it jobs run in-process) ──────
REDIS_URL=redis://localhost:6380

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Public origins allowed to call the API with credentials (comma separated)
CORS_ORIGINS=http://localhost:3200,http://localhost:3300
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=20
# 32-byte key (base64) used to encrypt sensitive HR fields (bank/PAN) at rest
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Secret used to sign private file download URLs (local storage driver)
FILE_URL_SIGNING_SECRET=replace-with-another-random-secret
COOKIE_SECURE=false
# Trust X-Forwarded-* from this many proxy hops (Next.js proxy, load balancer)
TRUST_PROXY_HOPS=1

# ── Public URLs ─────────────────────────────────────────────────────────────
WEB_PUBLIC_URL=http://localhost:3200
CONSOLE_PUBLIC_URL=http://localhost:3300
API_PUBLIC_URL=http://localhost:4000

# ── Project microsite domains ───────────────────────────────────────────────
# Root domain under which project subdomains are served (e.g. brand.in → green-valley.brand.in)
PLATFORM_ROOT_DOMAIN=localhost
# Hostnames that always serve the main marketplace (comma separated)
PLATFORM_MAIN_HOSTS=localhost,127.0.0.1
# CNAME target customers must point custom domains at (your ingress/load balancer hostname)
CUSTOM_DOMAIN_CNAME_TARGET=sites.example-ingress.net
# Optional A-record target (IPv4) accepted as an alternative to the CNAME
CUSTOM_DOMAIN_A_RECORD=
# TLS: none | caddy-on-demand (Caddy asks /api/v1/public/domains/tls-check before issuing certificates)
TLS_PROVIDER=none

# ── File storage ────────────────────────────────────────────────────────────
# local | s3   (s3 works with AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ── Notifications (leave blank = channel shows "not configured") ────────────
# Local development: Mailpit from docker-compose captures mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Basera <no-reply@example.com>"
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp Business Cloud API (Meta)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ── Spam protection (optional; Cloudflare Turnstile) ────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Maps ────────────────────────────────────────────────────────────────────
# Browser-restricted Google Maps Embed API key (optional). Without it OpenStreetMap embeds are used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Server-side geocoding (optional): google | none
GEOCODING_PROVIDER=none
GOOGLE_GEOCODING_API_KEY=

# ── Frontends ───────────────────────────────────────────────────────────────
# Internal URL the Next.js servers use to reach the API
API_INTERNAL_URL=http://localhost:4000
WEB_PORT=3200
CONSOLE_PORT=3300

# ── Development seed ────────────────────────────────────────────────────────
# Password assigned to every seeded development account. Seeding refuses to run when APP_ENV=production.
SEED_DEFAULT_PASSWORD=replace-with-a-dev-password
